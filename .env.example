# ふたりの名前と、ログイン用の数字PIN（4〜12桁。6桁以上がおすすめ）
MEMBER1_NAME=たつゆき
MEMBER1_PIN=
MEMBER2_NAME=かれん
MEMBER2_PIN=

# ログイン状態の署名に使うランダムな文字列（例: openssl rand -base64 32 の出力）
SESSION_SECRET=

# Supabase（Project Settings → API）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# レシートの自動読み取り（任意）。未設定なら写真の保存のみ
ANTHROPIC_API_KEY=
